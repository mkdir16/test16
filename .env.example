BOT_TOKEN=123456:ABC-твой-токен-от-BotFather
# Supabase: Connect -> Connection string -> URI.
# Для Render/бесплатного хостинга бери строку пулера (порт 6543, хост *.pooler.supabase.com),
# пароль — тот, что задавал при создании проекта (смотри в Project Settings -> Database).
# Пример: postgresql://postgres.xxxxx:[ПАРОЛЬ]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxx:твой-пароль@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
ADMIN_TG_ID=123456789
